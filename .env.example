DEEP_SEEK_API_KEY=sk-여기에-키를-넣으세요
DEEP_SEEK_MODEL=deepseek-v4-pro
LLM_PROVIDER=deepseek

# Ox Alpha(OpenRouter 경유, OpenAI 호환) — 모델 벤치마크·실험용.
# 모델 picker에서 "Ox" 선택 시 Developer가 이 모델로 실행된다. 키는 openrouter.ai에서 발급.
OX_ALPHA_API_KEY=sk-or-여기에-openrouter-키
OX_BASE_URL=https://openrouter.ai/api/v1
OX_MODEL=stealth/ox-alpha

PLANNER_MODEL=deepseek-v4-flash
PLANNER_PRO_MODEL=deepseek-v4-pro
CODER_MODEL=deepseek-v4-flash
REVIEWER_MODEL=deepseek-v4-flash
DEBUGGER_MODEL=deepseek-v4-flash

DATABASE_URL=postgresql+psycopg://forge:forge@localhost:5432/forge
REDIS_URL=redis://localhost:6379

WORKSPACE=/Users/insub/Desktop
LOGICAL_BUDGET=262144

# 앱 토큰 게이트(defense-in-depth). 설정 시 모든 /api 요청에 이 토큰을 요구한다.
# 활성화: 값 지정 후 backend 재시작 → PWA에서 localStorage.setItem('forge_token','<값>') 후 새로고침.
# 미설정이면 무동작(Cloudflare Access + 127.0.0.1 바인딩에만 의존).
FORGE_AUTH_TOKEN=
